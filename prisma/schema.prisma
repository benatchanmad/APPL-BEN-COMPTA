// BenComptaPro Africa - Prisma Schema
// SYSCOHADA Compliant Multi-Tenant SaaS Accounting
// Supports SQLite (local dev without external service) and PostgreSQL (Cloud SaaS production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. TENANCY & USERS
// ==========================================

model User {
  id             String                @id @default(cuid())
  email          String                @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  avatar         String?
  isActive       Boolean               @default(true)
  isSuperAdmin   Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  memberships    OrganizationMember[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  sessions       Session[]
}

model Organization {
  id              String                @id @default(cuid())
  name            String
  slug            String                @unique
  legalName       String?
  nif             String?               // Numéro d'Identification Fiscale (Niger / OHADA)
  rccm            String?               // Registre du Commerce et du Crédit Mobilier
  address         String?
  city            String?               @default("Niamey")
  country         String                @default("Niger")
  currency        String                @default("XOF") // FCFA
  phone           String?
  email           String?
  website         String?
  logoUrl         String?
  taxSystem       String                @default("REEL_NORMAL") // REEL_NORMAL, REEL_SIMPLIFIE, SYNTHETIQUE
  defaultVatRate  Float                 @default(19.0) // TVA Niger: 19%
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  members         OrganizationMember[]
  fiscalYears     FiscalYear[]
  accounts        AccountingAccount[]
  journals        AccountingJournal[]
  entries         AccountingEntry[]
  customers       Customer[]
  suppliers       Supplier[]
  invoices        Invoice[]
  payments        Payment[]
  expenses        Expense[]
  expenseCats     ExpenseCategory[]
  bankAccounts    BankAccount[]
  cashAccounts    CashAccount[]
  bankTx          BankTransaction[]
  taxRates        TaxRate[]
  taxDeclarations TaxDeclaration[]
  fixedAssets     FixedAsset[]
  products        Product[]
  stockMovements  StockMovement[]
  auditLogs       AuditLog[]
  subscriptions   Subscription[]
  notifications   Notification[]
}

model OrganizationMember {
  id              String       @id @default(cuid())
  userId          String
  organizationId  String
  role            String       @default("COMPTABLE") // SUPER_ADMIN, ADMIN, COMPTABLE, CAISSIER, GESTIONNAIRE, AUDITEUR, LECTEUR
  isActive        Boolean      @default(true)
  joinedAt        DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 2. COMPTABILITÉ SYSCOHADA (CLASSES 1 À 8)
// ==========================================

model FiscalYear {
  id              String            @id @default(cuid())
  organizationId  String
  name            String            // ex: "Exercice 2026"
  startDate       DateTime
  endDate         DateTime
  isClosed        Boolean           @default(false)
  closedAt        DateTime?
  closedBy        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries         AccountingEntry[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model AccountingAccount {
  id              String               @id @default(cuid())
  organizationId  String
  code            String               // ex: "411100", "521100", "701100"
  name            String               // ex: "Clients ordinaires", "Banque BOA Niger"
  accountClass    Int                  // 1 to 8 (SYSCOHADA)
  type            String               // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  parentCode      String?
  isReconcilable  Boolean              @default(false) // Lettrable
  isAuxiliary     Boolean              @default(false) // Compte de tiers
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entryLines      AccountingEntryLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, accountClass])
}

model AccountingJournal {
  id              String            @id @default(cuid())
  organizationId  String
  code            String            // AC (Achats), VT (Ventes), BQ (Banque), CA (Caisse), OD (Opérations Diverses)
  name            String            // Journal des Ventes, Journal des Achats, etc.
  type            String            // PURCHASES, SALES, BANK, CASH, GENERAL
  defaultAccountId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries         AccountingEntry[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model AccountingEntry {
  id                 String                @id @default(cuid())
  organizationId     String
  fiscalYearId       String
  journalId          String
  entryNumber        String                // Numérotation continue: VT-2026-0001
  date               DateTime
  description        String
  reference          String?               // N° Facture ou Chèque
  sourceType         String?               // INVOICE, PAYMENT, EXPENSE, MANUAL, CLOSING
  sourceId           String?
  status             String                @default("POSTED") // DRAFT, POSTED, LOCKED, CANCELLED
  postedAt           DateTime?             @default(now())
  createdBy          String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear         FiscalYear            @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  journal            AccountingJournal     @relation(fields: [journalId], references: [id], onDelete: Restrict)
  lines              AccountingEntryLine[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId, date])
  @@index([organizationId, journalId])
}

model AccountingEntryLine {
  id                 String             @id @default(cuid())
  entryId            String
  accountId          String
  auxiliaryType      String?            // CUSTOMER, SUPPLIER, EMPLOYEE
  auxiliaryId        String?
  description        String
  debit              Float              @default(0.0)
  credit             Float              @default(0.0)
  isReconciled       Boolean            @default(false) // Lettré
  reconciliationCode String?            // Code lettrage (ex: "AA", "AB")
  reconciledAt       DateTime?
  createdAt          DateTime           @default(now())

  entry              AccountingEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account            AccountingAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
}

// ==========================================
// 3. TIERS : CLIENTS & FOURNISSEURS
// ==========================================

model Customer {
  id               String         @id @default(cuid())
  organizationId   String
  code             String         // CLI0001
  name             String
  companyName      String?
  email            String?
  phone            String?
  address          String?
  city             String?        @default("Niamey")
  country          String         @default("Niger")
  nif              String?
  rccm             String?
  paymentTermsDays Int            @default(30)
  balance          Float          @default(0.0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  payments         Payment[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Supplier {
  id               String         @id @default(cuid())
  organizationId   String
  code             String         // FOU0001
  name             String
  companyName      String?
  email            String?
  phone            String?
  address          String?
  city             String?        @default("Niamey")
  country          String         @default("Niger")
  nif              String?
  rccm             String?
  paymentTermsDays Int            @default(30)
  balance          Float          @default(0.0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses         Expense[]
  payments         Payment[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// ==========================================
// 4. FACTURATION & VENTES
// ==========================================

model Invoice {
  id               String         @id @default(cuid())
  organizationId   String
  customerId       String
  invoiceNumber    String         // FAC-2026-0001
  type             String         @default("INVOICE") // INVOICE, QUOTE, PROFORMA, CREDIT_NOTE
  date             DateTime       @default(now())
  dueDate          DateTime
  status           String         @default("DRAFT") // DRAFT, SENT, PARTIAL, PAID, OVERDUE, CANCELLED
  subtotalHT       Float          @default(0.0)
  taxRate          Float          @default(19.0)
  taxAmount        Float          @default(0.0)
  discountAmount   Float          @default(0.0)
  totalTTC         Float          @default(0.0)
  paidAmount       Float          @default(0.0)
  balanceDue       Float          @default(0.0)
  notes            String?
  paymentTerms     String?        @default("Règlement sous 30 jours par virement ou chèque")
  accountingEntryId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items            InvoiceItem[]
  payments         Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([customerId])
}

model InvoiceItem {
  id               String         @id @default(cuid())
  invoiceId        String
  productId        String?
  description      String
  quantity         Float          @default(1.0)
  unitPrice        Float          @default(0.0)
  discountPercent  Float          @default(0.0)
  taxRate          Float          @default(19.0)
  subtotalHT       Float          @default(0.0)
  taxAmount        Float          @default(0.0)
  totalTTC         Float          @default(0.0)

  invoice          Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product          Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

// ==========================================
// 5. ACHATS & DÉPENSES
// ==========================================

model ExpenseCategory {
  id               String         @id @default(cuid())
  organizationId   String
  code             String         // ex: "LOY", "TEL", "CARB"
  name             String         // ex: "Loyers & Charges", "Télécommunication", "Carburant"
  defaultAccount   String         // ex: "622100", "628100", "605100"
  createdAt        DateTime       @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses         Expense[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Expense {
  id               String         @id @default(cuid())
  organizationId   String
  categoryId       String
  supplierId       String?
  bankAccountId    String?
  cashAccountId    String?
  expenseNumber    String         // DEP-2026-0001
  title            String
  description      String?
  date             DateTime       @default(now())
  amountHT         Float          @default(0.0)
  taxRate          Float          @default(19.0)
  taxAmount        Float          @default(0.0)
  totalTTC         Float          @default(0.0)
  paymentMethod    String         @default("CASH") // CASH, BANK_TRANSFER, CHECK, MOBILE_MONEY
  status           String         @default("PAID") // PENDING, APPROVED, PAID, REJECTED
  receiptUrl       String?
  accountingEntryId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier         Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bankAccount      BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  cashAccount      CashAccount?   @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)

  @@unique([organizationId, expenseNumber])
  @@index([organizationId])
  @@index([organizationId, status])
}

// ==========================================
// 6. TRÉSORERIE : BANQUES, CAISSES & PAIEMENTS
// ==========================================

model BankAccount {
  id               String            @id @default(cuid())
  organizationId   String
  bankName         String            // ex: "Banque BOA Niger", "Ecobank Niger", "BIA Niger"
  accountName      String            // ex: "Compte Courant Principal XOF"
  accountNumber    String
  iban             String?
  rib              String?
  currency         String            @default("XOF")
  initialBalance   Float             @default(0.0)
  currentBalance   Float             @default(0.0)
  glAccountCode    String            @default("521100") // SYSCOHADA 521: Banques
  isDefault        Boolean           @default(false)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions     BankTransaction[]
  payments         Payment[]
  expenses         Expense[]

  @@index([organizationId])
}

model CashAccount {
  id               String            @id @default(cuid())
  organizationId   String
  name             String            // ex: "Caisse Principale Siège", "Caisse Menues Dépenses"
  location         String?           @default("Siège Niamey")
  currency         String            @default("XOF")
  initialBalance   Float             @default(0.0)
  currentBalance   Float             @default(0.0)
  glAccountCode    String            @default("571100") // SYSCOHADA 571: Caisse siège
  isDefault        Boolean           @default(false)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions     BankTransaction[]
  payments         Payment[]
  expenses         Expense[]

  @@index([organizationId])
}

model BankTransaction {
  id               String            @id @default(cuid())
  organizationId   String
  bankAccountId    String?
  cashAccountId    String?
  date             DateTime          @default(now())
  valueDate        DateTime?
  reference        String?
  description      String
  type             String            // CREDIT, DEBIT
  amount           Float
  balanceAfter     Float?
  isReconciled     Boolean           @default(false)
  createdAt        DateTime          @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount      BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  cashAccount      CashAccount?      @relation(fields: [cashAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([bankAccountId])
  @@index([cashAccountId])
}

model Payment {
  id               String            @id @default(cuid())
  organizationId   String
  invoiceId        String?
  customerId       String?
  supplierId       String?
  bankAccountId    String?
  cashAccountId    String?
  paymentNumber    String            // REG-2026-0001
  date             DateTime          @default(now())
  amount           Float
  paymentMethod    String            @default("BANK_TRANSFER") // CASH, BANK_TRANSFER, CHECK, MOBILE_MONEY
  reference        String?           // N° Virement, N° Chèque, Référence Moov Money / Airtel Money
  notes            String?
  createdAt        DateTime          @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bankAccount      BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  cashAccount      CashAccount?      @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@index([invoiceId])
}

// ==========================================
// 7. FISCALITÉ : TVA & DÉCLARATIONS
// ==========================================

model TaxRate {
  id               String            @id @default(cuid())
  organizationId   String
  code             String            // TVA_19, TVA_0, EXONERE
  name             String            // TVA Normale Niger 19%, Taux Zéro, etc.
  ratePercent      Float             // 19.0, 0.0
  type             String            @default("STANDARD") // STANDARD, REDUCED, EXEMPT
  glAccountCode    String            // 443100 (Collectée) ou 445100 (Déductible)
  isDefault        Boolean           @default(false)
  createdAt        DateTime          @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
}

model TaxDeclaration {
  id                 String          @id @default(cuid())
  organizationId     String
  periodMonth        Int             // 1 to 12
  periodYear         Int             // 2026
  status             String          @default("DRAFT") // DRAFT, SUBMITTED, PAID
  totalBaseHT        Float           @default(0.0)
  totalTvaCollectee  Float           @default(0.0) // Compte 443
  totalTvaDeductible Float           @default(0.0) // Compte 445
  netTvaToPay        Float           @default(0.0) // Crédit de TVA si négatif
  notes              String?
  submittedAt        DateTime?
  paidAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodYear, periodMonth])
  @@index([organizationId])
}

// ==========================================
// 8. STOCKS & IMMOBILISATIONS
// ==========================================

model Product {
  id                 String          @id @default(cuid())
  organizationId     String
  code               String          // ART-001
  name               String
  description        String?
  unit               String          @default("unité") // unité, heure, forfait, carton, kg
  unitPrice          Float           @default(0.0)
  costPrice          Float           @default(0.0)
  stockQuantity      Float           @default(0.0)
  minStockLevel      Float           @default(5.0)
  taxRate            Float           @default(19.0)
  salesAccountCode   String          @default("701100") // Ventes de marchandises
  purchaseAccountCode String         @default("601100") // Achats de marchandises
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceItems       InvoiceItem[]
  stockMovements     StockMovement[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model StockMovement {
  id                 String          @id @default(cuid())
  organizationId     String
  productId          String
  type               String          // IN (Entrée), OUT (Sortie), ADJUSTMENT (Régularisation)
  quantity           Float
  unitCost           Float           @default(0.0)
  totalCost          Float           @default(0.0)
  reference          String?         // N° Bon de livraison, N° Facture
  notes              String?
  date               DateTime        @default(now())

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([productId])
}

model FixedAsset {
  id                 String          @id @default(cuid())
  organizationId     String
  assetCode          String          // IMMO-001
  name               String          // Véhicule de service, Serveur informatique, etc.
  acquisitionDate    DateTime
  acquisitionCost    Float
  salvageValue       Float           @default(0.0)
  usefulLifeYears    Int             @default(5)
  depreciationMethod String          @default("LINEAR") // LINEAR (Linéaire SYSCOHADA)
  accumulatedDepr    Float           @default(0.0)
  netBookValue       Float           @default(0.0)
  assetAccountCode   String          @default("241100") // Matériel et outillage
  deprExpenseCode    String          @default("681200") // Dotations aux amortissements
  accumDeprCode      String          @default("284100") // Amortissement matériel
  status             String          @default("ACTIVE") // ACTIVE, FULLY_DEPRECIATED, DISPOSED
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, assetCode])
  @@index([organizationId])
}

// ==========================================
// 9. SAAS, ABONNEMENTS, AUDIT & NOTIFICATIONS
// ==========================================

model Subscription {
  id                 String          @id @default(cuid())
  organizationId     String
  plan               String          @default("BUSINESS") // STARTER, BUSINESS, ENTERPRISE
  status             String          @default("ACTIVE") // TRIAL, ACTIVE, PAST_DUE, CANCELLED
  billingCycle       String          @default("MONTHLY") // MONTHLY, YEARLY
  amount             Float           @default(25000.0) // 25 000 FCFA / mois
  startDate          DateTime        @default(now())
  endDate            DateTime
  maxUsers           Int             @default(10)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuditLog {
  id                 String          @id @default(cuid())
  organizationId     String?
  userId             String?
  action             String          // CREATE, UPDATE, DELETE, POST_ENTRY, CLOSE_YEAR, EXPORT
  entity             String          // INVOICE, ENTRY, ACCOUNT, PAYMENT, EXPENSE
  entityId           String?
  details            String?
  ipAddress          String?
  createdAt          DateTime        @default(now())

  organization       Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id                 String          @id @default(cuid())
  organizationId     String
  userId             String?
  title              String
  message            String
  type               String          @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  isRead             Boolean         @default(false)
  link               String?
  createdAt          DateTime        @default(now())

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}
