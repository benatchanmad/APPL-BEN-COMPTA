// BenComptaPro Africa - Prisma Schema for PostgreSQL (Production Cloud)
// Compatible with Neon, Supabase, Railway, AWS RDS, Docker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String                @id @default(cuid())
  email          String                @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  avatar         String?
  isActive       Boolean               @default(true)
  isSuperAdmin   Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  memberships    OrganizationMember[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  sessions       Session[]
}

model Organization {
  id              String                @id @default(cuid())
  name            String
  slug            String                @unique
  legalName       String?
  nif             String?
  rccm            String?
  address         String?
  city            String?               @default("Niamey")
  country         String                @default("Niger")
  currency        String                @default("XOF")
  phone           String?
  email           String?
  website         String?
  logoUrl         String?
  taxSystem       String                @default("REEL_NORMAL")
  defaultVatRate  Float                 @default(19.0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  members         OrganizationMember[]
  fiscalYears     FiscalYear[]
  accounts        AccountingAccount[]
  journals        AccountingJournal[]
  entries         AccountingEntry[]
  customers       Customer[]
  suppliers       Supplier[]
  invoices        Invoice[]
  payments        Payment[]
  expenses        Expense[]
  expenseCats     ExpenseCategory[]
  bankAccounts    BankAccount[]
  cashAccounts    CashAccount[]
  bankTx          BankTransaction[]
  taxRates        TaxRate[]
  taxDeclarations TaxDeclaration[]
  fixedAssets     FixedAsset[]
  products        Product[]
  stockMovements  StockMovement[]
  auditLogs       AuditLog[]
  subscriptions   Subscription[]
  notifications   Notification[]
}

model OrganizationMember {
  id              String       @id @default(cuid())
  userId          String
  organizationId  String
  role            String       @default("COMPTABLE")
  isActive        Boolean      @default(true)
  joinedAt        DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FiscalYear {
  id              String            @id @default(cuid())
  organizationId  String
  name            String
  startDate       DateTime
  endDate         DateTime
  isClosed        Boolean           @default(false)
  closedAt        DateTime?
  closedBy        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries         AccountingEntry[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model AccountingAccount {
  id              String               @id @default(cuid())
  organizationId  String
  code            String
  name            String
  accountClass    Int
  type            String
  parentCode      String?
  isReconcilable  Boolean              @default(false)
  isAuxiliary     Boolean              @default(false)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entryLines      AccountingEntryLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, accountClass])
}

model AccountingJournal {
  id              String            @id @default(cuid())
  organizationId  String
  code            String
  name            String
  type            String
  defaultAccountId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries         AccountingEntry[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model AccountingEntry {
  id                 String                @id @default(cuid())
  organizationId     String
  fiscalYearId       String
  journalId          String
  entryNumber        String
  date               DateTime
  description        String
  reference          String?
  sourceType         String?
  sourceId           String?
  status             String                @default("POSTED")
  postedAt           DateTime?             @default(now())
  createdBy          String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear         FiscalYear            @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  journal            AccountingJournal     @relation(fields: [journalId], references: [id], onDelete: Restrict)
  lines              AccountingEntryLine[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId, date])
  @@index([organizationId, journalId])
}

model AccountingEntryLine {
  id                 String             @id @default(cuid())
  entryId            String
  accountId          String
  auxiliaryType      String?
  auxiliaryId        String?
  description        String
  debit              Float              @default(0.0)
  credit             Float              @default(0.0)
  isReconciled       Boolean            @default(false)
  reconciliationCode String?
  reconciledAt       DateTime?
  createdAt          DateTime           @default(now())

  entry              AccountingEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account            AccountingAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
}

model Customer {
  id               String         @id @default(cuid())
  organizationId   String
  code             String
  name             String
  companyName      String?
  email            String?
  phone            String?
  address          String?
  city             String?        @default("Niamey")
  country          String         @default("Niger")
  nif              String?
  rccm             String?
  paymentTermsDays Int            @default(30)
  balance          Float          @default(0.0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  payments         Payment[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Supplier {
  id               String         @id @default(cuid())
  organizationId   String
  code             String
  name             String
  companyName      String?
  email            String?
  phone            String?
  address          String?
  city             String?        @default("Niamey")
  country          String         @default("Niger")
  nif              String?
  rccm             String?
  paymentTermsDays Int            @default(30)
  balance          Float          @default(0.0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses         Expense[]
  payments         Payment[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Invoice {
  id               String         @id @default(cuid())
  organizationId   String
  customerId       String
  invoiceNumber    String
  type             String         @default("INVOICE")
  date             DateTime       @default(now())
  dueDate          DateTime
  status           String         @default("DRAFT")
  subtotalHT       Float          @default(0.0)
  taxRate          Float          @default(19.0)
  taxAmount        Float          @default(0.0)
  discountAmount   Float          @default(0.0)
  totalTTC         Float          @default(0.0)
  paidAmount       Float          @default(0.0)
  balanceDue       Float          @default(0.0)
  notes            String?
  paymentTerms     String?        @default("Règlement sous 30 jours par virement ou chèque")
  accountingEntryId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items            InvoiceItem[]
  payments         Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([customerId])
}

model InvoiceItem {
  id               String         @id @default(cuid())
  invoiceId        String
  productId        String?
  description      String
  quantity         Float          @default(1.0)
  unitPrice        Float          @default(0.0)
  discountPercent  Float          @default(0.0)
  taxRate          Float          @default(19.0)
  subtotalHT       Float          @default(0.0)
  taxAmount        Float          @default(0.0)
  totalTTC         Float          @default(0.0)

  invoice          Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product          Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model ExpenseCategory {
  id               String         @id @default(cuid())
  organizationId   String
  code             String
  name             String
  defaultAccount   String
  createdAt        DateTime       @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses         Expense[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Expense {
  id               String         @id @default(cuid())
  organizationId   String
  categoryId       String
  supplierId       String?
  bankAccountId    String?
  cashAccountId    String?
  expenseNumber    String
  title            String
  description      String?
  date             DateTime       @default(now())
  amountHT         Float          @default(0.0)
  taxRate          Float          @default(19.0)
  taxAmount        Float          @default(0.0)
  totalTTC         Float          @default(0.0)
  paymentMethod    String         @default("CASH")
  status           String         @default("PAID")
  receiptUrl       String?
  accountingEntryId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier         Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bankAccount      BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  cashAccount      CashAccount?   @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)

  @@unique([organizationId, expenseNumber])
  @@index([organizationId])
  @@index([organizationId, status])
}

model BankAccount {
  id               String            @id @default(cuid())
  organizationId   String
  bankName         String
  accountName      String
  accountNumber    String
  iban             String?
  rib              String?
  currency         String            @default("XOF")
  initialBalance   Float             @default(0.0)
  currentBalance   Float             @default(0.0)
  glAccountCode    String            @default("521100")
  isDefault        Boolean           @default(false)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions     BankTransaction[]
  payments         Payment[]
  expenses         Expense[]

  @@index([organizationId])
}

model CashAccount {
  id               String            @id @default(cuid())
  organizationId   String
  name             String
  location         String?           @default("Siège Niamey")
  currency         String            @default("XOF")
  initialBalance   Float             @default(0.0)
  currentBalance   Float             @default(0.0)
  glAccountCode    String            @default("571100")
  isDefault        Boolean           @default(false)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions     BankTransaction[]
  payments         Payment[]
  expenses         Expense[]

  @@index([organizationId])
}

model BankTransaction {
  id               String            @id @default(cuid())
  organizationId   String
  bankAccountId    String?
  cashAccountId    String?
  date             DateTime          @default(now())
  valueDate        DateTime?
  reference        String?
  description      String
  type             String
  amount           Float
  balanceAfter     Float?
  isReconciled     Boolean           @default(false)
  createdAt        DateTime          @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount      BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  cashAccount      CashAccount?      @relation(fields: [cashAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([bankAccountId])
  @@index([cashAccountId])
}

model Payment {
  id               String            @id @default(cuid())
  organizationId   String
  invoiceId        String?
  customerId       String?
  supplierId       String?
  bankAccountId    String?
  cashAccountId    String?
  paymentNumber    String
  date             DateTime          @default(now())
  amount           Float
  paymentMethod    String            @default("BANK_TRANSFER")
  reference        String?
  notes            String?
  createdAt        DateTime          @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bankAccount      BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  cashAccount      CashAccount?      @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@index([invoiceId])
}

model TaxRate {
  id               String            @id @default(cuid())
  organizationId   String
  code             String
  name             String
  ratePercent      Float
  type             String            @default("STANDARD")
  glAccountCode    String
  isDefault        Boolean           @default(false)
  createdAt        DateTime          @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
}

model TaxDeclaration {
  id                 String          @id @default(cuid())
  organizationId     String
  periodMonth        Int
  periodYear         Int
  status             String          @default("DRAFT")
  totalBaseHT        Float           @default(0.0)
  totalTvaCollectee  Float           @default(0.0)
  totalTvaDeductible Float           @default(0.0)
  netTvaToPay        Float           @default(0.0)
  notes              String?
  submittedAt        DateTime?
  paidAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodYear, periodMonth])
  @@index([organizationId])
}

model Product {
  id                 String          @id @default(cuid())
  organizationId     String
  code               String
  name               String
  description        String?
  unit               String          @default("unité")
  unitPrice          Float           @default(0.0)
  costPrice          Float           @default(0.0)
  stockQuantity      Float           @default(0.0)
  minStockLevel      Float           @default(5.0)
  taxRate            Float           @default(19.0)
  salesAccountCode   String          @default("701100")
  purchaseAccountCode String         @default("601100")
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceItems       InvoiceItem[]
  stockMovements     StockMovement[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model StockMovement {
  id                 String          @id @default(cuid())
  organizationId     String
  productId          String
  type               String
  quantity           Float
  unitCost           Float           @default(0.0)
  totalCost          Float           @default(0.0)
  reference          String?
  notes              String?
  date               DateTime        @default(now())

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([productId])
}

model FixedAsset {
  id                 String          @id @default(cuid())
  organizationId     String
  assetCode          String
  name               String
  acquisitionDate    DateTime
  acquisitionCost    Float
  salvageValue       Float           @default(0.0)
  usefulLifeYears    Int             @default(5)
  depreciationMethod String          @default("LINEAR")
  accumulatedDepr    Float           @default(0.0)
  netBookValue       Float           @default(0.0)
  assetAccountCode   String          @default("241100")
  deprExpenseCode    String          @default("681200")
  accumDeprCode      String          @default("284100")
  status             String          @default("ACTIVE")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, assetCode])
  @@index([organizationId])
}

model Subscription {
  id                 String          @id @default(cuid())
  organizationId     String
  plan               String          @default("BUSINESS")
  status             String          @default("ACTIVE")
  billingCycle       String          @default("MONTHLY")
  amount             Float           @default(25000.0)
  startDate          DateTime        @default(now())
  endDate            DateTime
  maxUsers           Int             @default(10)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuditLog {
  id                 String          @id @default(cuid())
  organizationId     String?
  userId             String?
  action             String
  entity             String
  entityId           String?
  details            String?
  ipAddress          String?
  createdAt          DateTime        @default(now())

  organization       Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id                 String          @id @default(cuid())
  organizationId     String
  userId             String?
  title              String
  message            String
  type               String          @default("INFO")
  isRead             Boolean         @default(false)
  link               String?
  createdAt          DateTime        @default(now())

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}
