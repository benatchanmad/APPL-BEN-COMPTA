# BenComptaPro Africa - Exemple de Configuration Environnement

# Base de données PostgreSQL (Recommandé en Production SaaS)
# DATABASE_URL="postgresql://user:password@hostname:5432/bencomptapro?sslmode=require"

# Base de données locale pour test rapide sans serveur externe (Optionnel)
DATABASE_URL="file:./dev.db"

# Clés secrètes d'authentification et chiffrement de sessions
JWT_SECRET="remplacez_par_une_cle_secrete_aleatoire_de_64_caracteres"
NEXTAUTH_SECRET="remplacez_par_une_cle_secrete_aleatoire_de_64_caracteres"

# Configuration Régionale par défaut
NEXT_PUBLIC_APP_NAME="BenComptaPro Africa"
NEXT_PUBLIC_DEFAULT_CURRENCY="FCFA"
NEXT_PUBLIC_DEFAULT_COUNTRY="Niger"
NEXT_PUBLIC_DEFAULT_VAT_RATE=19
